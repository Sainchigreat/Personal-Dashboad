# Local Express/SQLite API (unchanged sandbox preview mode)
# Use a persistent volume for production, e.g. /var/lib/momentum.
DATA_DIR=./data/workspace
PORT=3001
# Only enable in an isolated sandbox. Preview mode bypasses private sign-in.
# MOMENTUM_PREVIEW=1

# ---- Momentum AI / Supabase cloud backend --------------------------------
# Safe for the browser: the publishable (anon) key. RLS protects every row.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Optional: used by `npm run verify:cloud` from a machine with internet access.
# SUPABASE_SERVICE_ROLE_KEY is NEVER needed by the browser or the frontend build.
# Keep any secret/service-role key in your host's environment, never in Git.
