# Local Express/SQLite API (unchanged sandbox preview mode)
# Use a persistent volume for production, e.g. /var/lib/momentum.
DATA_DIR=./data/workspace
PORT=3001
# Only enable in an isolated sandbox. Preview mode bypasses private sign-in.
# MOMENTUM_PREVIEW=1

# ---- Momentum AI / Supabase cloud backend --------------------------------
# Safe for the browser: the publishable (anon) key. RLS protects every row.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Optional: used by `npm run verify:cloud` from a machine with internet access.
# SUPABASE_SERVICE_ROLE_KEY is NEVER needed by the browser or the frontend build.
# Keep any secret/service-role key in your host's environment, never in Git.

# ---- Server-side PostgreSQL (Netlify Functions / Express) ------------------
# DATABASE_URL is a SERVER-ONLY secret. Set it in Netlify ->
# Site configuration -> Environment variables, or in a local .env.local.
# Use the pooled connection string from the existing Momentum project's
# Connect panel. NEVER commit it, never log it, never prefix it with VITE_.
# DATABASE_URL=
# PG_POOL_MAX=5

# ---- Personal-workspace scoping (names only) -------------------------------
# MOMENTUM_PERSONAL_OWNER_EMAIL scopes Chisom's November plan to ONE verified
# account. If unset, the DB marker table personal_plan_owner is used instead.
# Chisom's plan is NEVER a default for new accounts. No secret value here.
# MOMENTUM_PERSONAL_OWNER_EMAIL=
# MOMENTUM_PERSONAL_OWNER_ID=   # used by npm run reconcile:personal

